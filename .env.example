HOST=127.0.0.1
PORT=4180
SITE_ORIGIN=https://brilliant-monolit.ru
NODE_ENV=development
COOKIE_SECURE=false
DATA_DIR=./data
# Set a unique initial password (12+ characters), or run npm run admin:reset.
INIT_ADMIN_LOGIN=admin
INIT_ADMIN_PASSWORD=
# In production: NODE_ENV=production, COOKIE_SECURE=true,
# HOST=0.0.0.0, ALLOWED_ORIGINS=https://brilliant-monolit.ru
ALLOWED_ORIGINS=http://127.0.0.1:4180,http://localhost:4180
# Set to 1 only when app is reachable exclusively through one trusted reverse proxy.
TRUST_PROXY=0
