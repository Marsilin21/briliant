{
  "name": "brilliant-monolit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "admin:dev": "vite --host 127.0.0.1",
    "admin:reset": "node --env-file-if-exists=.env scripts/admin-password.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "cheerio": "1.2.0",
    "fastify": "5.12.3",
    "nodemailer": "10.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "vite": "8.2.2"
  }
}
